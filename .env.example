# --- Oracle database ---
ORACLE_PASSWORD=OptiRoute123
DB_USER=OPTIROUTE
DB_PASSWORD=optiroute
# Internal Docker service identifier used by the backend connection pool.
DB_DSN=oracle-db:1521/XEPDB1

# --- Backend ---
ENGINE_BIN=/app/engine/engine
ENGINE_TIMEOUT_MS=5000
LOG_LEVEL=info

# --- Frontend (dev only; compose serves the built bundle over nginx) ---
VITE_API_BASE=/api
